      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"shopflow-api\"}[5m])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"shopflow-api\"}[5m])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"shopflow-api\"}[5m])))",
          "legendFormat": "p99",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
