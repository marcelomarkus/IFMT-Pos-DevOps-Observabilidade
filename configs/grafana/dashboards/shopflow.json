        "h": 5,
        "w": 6,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(shopflow_orders_completed_total[5m]))",
          "legendFormat": "pedidos",
          "instant": true,
          "range": false
