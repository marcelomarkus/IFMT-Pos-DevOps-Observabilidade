    {
      "id": 15,
      "type": "timeseries",
      "title": "CPU do host (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(rate(system_cpu_time_seconds_total{state=\"idle\"}[2m])) / sum(rate(system_cpu_time_seconds_total[2m])))",
          "legendFormat": "uso de CPU",
          "instant": false,
          "range": true
