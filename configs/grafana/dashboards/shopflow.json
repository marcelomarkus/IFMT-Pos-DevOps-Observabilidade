    {
      "id": 11,
      "type": "timeseries",
      "title": "Pedidos concluidos x falhos (por 5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(shopflow_orders_completed_total[5m]))",
          "legendFormat": "concluidos",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(increase(shopflow_orders_failed_total[5m]))",
          "legendFormat": "falhos",
          "instant": false,
          "range": true
