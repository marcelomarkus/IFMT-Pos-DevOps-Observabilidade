      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(shopflow_orders_failed_total[5m])) + sum(increase(shopflow_auth_failures_total[5m]))",
          "legendFormat": "falhas",
          "instant": true,
          "range": false
